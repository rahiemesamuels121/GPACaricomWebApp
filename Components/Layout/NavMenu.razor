@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

<nav class="navbar navbar-expand-lg  custom-navbar ">

    <div class="container">

        <!-- Logo -->
        <a class="navbar-brand d-flex align-items-center" href="/">

            <img src="/images/logomain.png"
                 alt="GPA Caribbean"
                 class="navbar-logo" />

            <div class="ms-3">
                <div class="brand-title">
                    GPA Caribbean
                </div>

                <div class="brand-subtitle">
                    Youth • Leadership • Opportunity
                </div>
            </div>

        </a>

        <!-- Mobile Toggle -->
        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNav">

            <span class="navbar-toggler-icon"></span>

        </button>

        <!-- Navigation -->
        <div class="collapse navbar-collapse"
             id="mainNav">

            <ul class="navbar-nav mx-auto">

                <li class="nav-item">
                    <NavLink class="nav-link"
                             href=""
                             Match="NavLinkMatch.All">

                        <i class="bi bi-house-door-fill"></i>
                        Home

                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link"
                             href="who-we-are">

                        <i class="bi bi-people-fill"></i>
                        Who We Are

                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link"
                             href="our-programs">

                        <i class="bi bi-mortarboard-fill"></i>
                        Programs

                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link"
                             href="our-services">

                        <i class="bi bi-briefcase-fill"></i>
                        Our Services

                    </NavLink>
                </li>

                <li class="nav-item">
                    <NavLink class="nav-link"
                             href="contact-us">

                        <i class="bi bi-envelope-fill"></i>
                        Contact

                    </NavLink>
                </li>

            </ul>

            <div class="d-flex">

                <a href="/our-programs"
                   class="btn btn-outline-light me-2">
                    Join a Program
                </a>
                <AuthorizeView>
                    <Authorized>
                        <a href="/dashboard">
                    <RadzenGravatar Email="@userid" />
                            </a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login"
                           class="btn login-btn">
                            Log In
                        </a>
                    </NotAuthorized>
                   
                    

                </AuthorizeView>

              

            </div>


        </div>

    </div>

</nav>
<style>
    .custom-navbar .nav-link {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: .75rem 1.4rem;
        border-radius: 999px;
        color: var(--secondary-blue);
        text-decoration: none;
        transition: color .35s ease, background-color .35s ease, transform .35s ease, box-shadow .35s ease;
    }

        .custom-navbar .nav-link::after {
            content: "";
            position: absolute;
            left: 50%;
            bottom: -4px;
            width: 0;
            height: 3px;
            background: var(--primary-yellow);
            border-radius: 999px;
            transform: translateX(-50%);
            transition: width .35s ease;
        }

        .custom-navbar .nav-link:hover::after {
            width: 70%;
        }

        .custom-navbar .nav-link.active::after {
            width: 90%;
        }

        .custom-navbar .nav-link.active {
            color: var(--secondary-blue);
            font-weight: 700;
            transform: translateY(-2px);
        }
</style>
@code{

    string userid;
    protected override async Task OnInitializedAsync()
    {
        await checkLoginStatus();
    }
    public async Task checkLoginStatus(){
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated ?? false == true)
        {
            
            userid = user.FindFirst(ClaimTypes.Name)?.Value??"BOM";
        }
    
    }

}