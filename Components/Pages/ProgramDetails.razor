@page "/program-details/{ProgramId:int}"

@using GPACARICOM.Models
@using GPACARICOM.Services.API
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager navigationManager
@rendermode InteractiveServer
@inject ProgramApiService ProgramApiService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Program Details</PageTitle>



@if (isLoading)
{
    <div class="container py-5 text-center">
        <div class="spinner-border text-warning" role="status"></div>
        <p class="mt-3">Loading program details...</p>
    </div>
}
else if (program == null)
{
    <div class="container py-5 text-center">
        <div class="alert alert-warning shadow-sm">
            <h4>Program Not Found</h4>
            <p>The requested program could not be found.</p>
        </div>
    </div>
}
else
{

    @if (showLoginModal)
    {
        <div class="modal fade show d-block" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Login Required</h5>
                        <button type="button"
                                class="btn-close"
                                @onclick="CloseLoginModal">
                        </button>
                    </div>

                    <div class="modal-body">
                        <p>You must be logged in to continue.</p>

                        <button class="btn btn-warning me-2"
                                @onclick="GoToLogin">
                            Login
                        </button>

                        <button class="btn btn-outline-secondary"
                                @onclick="CloseLoginModal">
                            Cancel
                        </button>
                    </div>

                </div>
            </div>
        </div>

        <!-- Dark background -->
        <div class="modal-backdrop fade show"></div>
    }
    <!-- Hero -->
    <div class="contact-hero">
        <h1>@program.programName</h1>
        <p>
            Learn more about this program and discover how it can help
            empower Caribbean youth.
        </p>
    </div>

    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-lg-10">

                <div class="contact-form-card">

                    <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">

                        <div>
                            <span class="badge bg-warning text-dark px-3 py-2">
                                <i class="bi bi-calendar-event me-2"></i>
                            
                                @program.programDate.ToString("dddd, MMMM dd, yyyy")
                            </span>
                        </div>

                    </div>

                    <h3 class="mb-4">
                        About This Program
                    </h3>

                    <p class="program-description">
                        @program.programDescription
                    </p>

                    <button class="btn-warning" @onclick="CheckLoginStatus">
                        Register For this Program
                    </button>

                </div>

            </div>

        </div>

    </div>
}

@code {

    [Parameter]
    public int ProgramId { get; set; }

    private ProgramModel? program;
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        var result = await ProgramApiService.GetProgrambyId(ProgramId.ToString());

        if (result.success)
        {
            program = result.data;
        }

        isLoading = false;
    }




    private bool showLoginModal;

    private async Task  CheckLoginStatus()
    {


        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        Console.WriteLine((user.Identity?.IsAuthenticated));

        if (user.Identity?.IsAuthenticated == true)
        {
            navigationManager.NavigateTo("/program-registration", forceLoad: true);
        }
        else
        {
        showLoginModal = true;
            
        }
    }

    private void CloseLoginModal()
    {
        showLoginModal = false;
    }

    private void GoToLogin()
    {
        navigationManager.NavigateTo("/login");
    }
}