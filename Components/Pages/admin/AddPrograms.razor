@page "/admin/programs/new"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms

@attribute [Authorize]

@inject NavigationManager Navigation
@* @inject IProgramApiService ProgramApiService *@

<PageTitle>Add New Program | GPA Caribbean</PageTitle>


<div class="add-program-page">

    <!-- ===============================
         PAGE HEADER
    ================================ -->

    <div class="page-header">

        <div>

            <button type="button"
                    class="back-button"
                    @onclick="GoBack">

                <i class="bi bi-arrow-left"></i>
                Programs

            </button>

            <span class="page-eyebrow">
                PROGRAM MANAGEMENT
            </span>

            <h1>Add New Program</h1>

            <p>
                Create a new GPA Caribbean programme and upload
                its featured image.
            </p>

        </div>

    </div>


    <!-- ===============================
         MESSAGES
    ================================ -->
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert-message error">

            <i class="bi bi-exclamation-circle"></i>

            <span>@ErrorMessage</span>

        </div>
    }


    <!-- ===============================
         FORM
    ================================ -->

    <EditForm Model="@Program"
              OnValidSubmit="HandleValidSubmit">

        <DataAnnotationsValidator />

        <div class="form-layout">


            <!-- ===============================
                 LEFT COLUMN
            ================================ -->

            <div class="form-card">

                <div class="card-header">

                    <div class="card-icon">
                        <i class="bi bi-journal-text"></i>
                    </div>

                    <div>
                        <h2>Program Information</h2>
                        <p>
                            Enter the main information about the program.
                        </p>
                    </div>

                </div>


                <!-- PROGRAM NAME -->

                <div class="form-group">

                    <label>
                        Program Name
                        <span class="required">*</span>
                    </label>

                    <InputText class="form-control"
                               @bind-Value="Program.ProgramName"
                               placeholder="e.g. Drone Awareness & Basic Operation" />

                    <ValidationMessage For="@(() => Program.ProgramName)" />

                </div>


                <!-- DESCRIPTION -->

                <div class="form-group">

                    <label>
                        Program Description
                        <span class="required">*</span>
                    </label>

                    <InputTextArea class="form-control description"
                                   @bind-Value="Program.Description"
                                   placeholder="Describe the program, its objectives and what participants can expect..." />

                    <div class="field-footer">

                        <ValidationMessage For="@(() => Program.Description)" />

                        <span>
                            @(Program.Description?.Length ?? 0) / 2000
                        </span>

                    </div>

                </div>


                <!-- PROGRAM DATE -->

                <div class="form-group">

                    <label>
                        Program Date
                        <span class="required">*</span>
                    </label>

                    <div class="input-icon-wrapper">

                        <i class="bi bi-calendar-event"></i>

                        <InputDate class="form-control date-input"
                                   @bind-Value="Program.ProgramDate" />

                    </div>

                    <ValidationMessage For="@(() => Program.ProgramDate)" />

                </div>

            </div>


            <!-- ===============================
                 RIGHT COLUMN
            ================================ -->

            <div class="form-card">

                <div class="card-header">

                    <div class="card-icon yellow">
                        <i class="bi bi-image"></i>
                    </div>

                    <div>

                        <h2>Program Image</h2>

                        <p>
                            Upload the featured image displayed
                            with the program.
                        </p>

                    </div>

                </div>


                <!-- IMAGE UPLOAD -->

                <div class="image-upload-container">


                    @if (string.IsNullOrWhiteSpace(ImagePreview))
                    {
                        <label class="upload-zone">

                            <InputFile OnChange="HandleImageSelected"
                                       accept=".jpg,.jpeg,.png,.webp"
                                       class="file-input" />

                            <div class="upload-icon">

                                <i class="bi bi-cloud-arrow-up"></i>

                            </div>

                            <h3>Upload program image</h3>

                            <p>
                                Click to browse for an image
                            </p>

                            <span>
                                JPG, JPEG, PNG or WEBP • Maximum 5 MB
                            </span>

                        </label>
                    }
                    else
                    {
                        <div class="image-preview">

                            <img src="@ImagePreview"
                                 alt="Selected program image" />

                            <div class="preview-overlay">

                                <label class="change-image-button">

                                    <InputFile OnChange="HandleImageSelected"
                                               accept=".jpg,.jpeg,.png,.webp"
                                               class="file-input" />

                                    <i class="bi bi-camera"></i>

                                    Change Image

                                </label>

                            </div>

                        </div>


                        <div class="selected-file">

                            <div class="file-icon">
                                <i class="bi bi-image"></i>
                            </div>

                            <div class="file-information">

                                <strong>
                                    @SelectedImage?.Name
                                </strong>

                                <span>
                                    @GetFileSize()
                                </span>

                            </div>

                            <button type="button"
                                    class="remove-file"
                                    title="Remove image"
                                    @onclick="RemoveImage">

                                <i class="bi bi-trash"></i>

                            </button>

                        </div>
                    }

                </div>


                <div class="image-help">

                    <i class="bi bi-info-circle"></i>

                    <span>
                        For the best appearance, use a landscape image
                        with a 16:9 aspect ratio.
                    </span>

                </div>

            </div>

        </div>


        <!-- ===============================
             ACTION BAR
        ================================ -->

        <div class="form-actions">

            <button type="button"
                    class="cancel-button"
                    disabled="@IsSaving"
                    @onclick="GoBack">

                Cancel

            </button>


            <button type="submit"
                    class="save-button"
                    disabled="@IsSaving">

                @if (IsSaving)
                {
                    <span class="spinner-border spinner-border-sm"></span>

                    <span>
                        Creating Program...
                    </span>
                }
                else
                {
                    <i class="bi bi-check-lg"></i>

                    <span>
                        Create Program
                    </span>
                }

            </button>

        </div>

    </EditForm>

</div>


<style>

    .add-program-page {
        min-height: 100vh;
        background: #f5f8fb;
        padding: 2.5rem;
    }


    /* ==============================
           HEADER
        ============================== */

