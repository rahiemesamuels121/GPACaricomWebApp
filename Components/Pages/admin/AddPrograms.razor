        font-size: 0.7rem;
    }


    /* ==============================
           IMAGE PREVIEW
        ============================== */

    .image-preview {
        position: relative;
        height: 300px;
        overflow: hidden;
        border-radius: 16px;
        background: #eaf1f4;
    }


        .image-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }


    .preview-overlay {
        position: absolute;
