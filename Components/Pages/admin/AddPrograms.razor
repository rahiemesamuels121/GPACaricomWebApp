        ============================== */

    .form-group {
        margin-bottom: 1.6rem;
    }


        .form-group label {
            display: block;
            margin-bottom: 0.55rem;
            font-size: 0.85rem;
            font-weight: 800;
            color: #324e5e;
        }


    .required {
        color: #d74a4a;
    }


    .form-control {
