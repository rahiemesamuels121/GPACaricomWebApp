        max-width: 1200px;
        margin: 0 auto 2rem;
    }


    .back-button {
        border: none;
        background: transparent;
        padding: 0;
        margin-bottom: 1.2rem;
        display: flex;
        align-items: center;
        gap: 0.45rem;
        color: #527080;
        font-weight: 700;
