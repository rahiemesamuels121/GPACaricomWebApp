        align-items: center;
        gap: 0.6rem;
    }


        .alert-message.error {
            background: #fff1f1;
            border: 1px solid #f3cccc;
            color: #a93c3c;
        }


    /* ==============================
           ACTION BAR
        ============================== */

    .form-actions {
        max-width: 1200px;
        margin: 1.5rem auto 0;
        display: flex;
        justify-content: flex-end;
        gap: 0.8rem;
        padding: 1.3rem 1.5rem;
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #e9eff3;
        box-shadow: 0 8px 25px rgba(0, 48, 72, 0.04);
    }


    .cancel-button,
    .save-button {
        border: none;
        border-radius: 10px;
        padding: 0.85rem 1.3rem;
        font-size: 0.88rem;
        font-weight: 800;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }


    .cancel-button {
        background: #edf2f4;
        color: #4d6571;
    }


    .save-button {
        min-width: 170px;
        background: #FDB813;
        color: #173747;
        box-shadow: 0 7px 18px rgba(253,184,19,0.25);
    }


        .save-button:hover:not(:disabled) {
            transform: translateY(-1px);
        }


        .save-button:disabled,
        .cancel-button:disabled {
            opacity: 0.65;
            cursor: not-allowed;
        }


    /* ==============================
           RESPONSIVE
        ============================== */

    @@media (max-width: 900px) {

        .form-layout {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 600px) {

        .add-program-page {
            padding: 1rem;
        }


        .form-card {
            padding: 1.25rem;
        }


        .form-actions {
            flex-direction: column-reverse;
        }


        .cancel-button,
        .save-button {
            width: 100%;
        }
    }

</style>


@code {

    private const long MaxFileSize =
        5 * 1024 * 1024;


    private CreateProgramModel Program { get; set; }
        = new();


    private IBrowserFile? SelectedImage;

    private string? ImagePreview;

    private string? ErrorMessage;

    private bool IsSaving;


    protected override void OnInitialized()
    {
        Program.ProgramDate =
            DateTime.Today.AddDays(1);
    }


    private async Task HandleImageSelected(
        InputFileChangeEventArgs e)
    {
        ErrorMessage = null;

        var file = e.File;


        if (file.Size > MaxFileSize)
        {
            ErrorMessage =
                "The image cannot exceed 5 MB.";

            RemoveImage();

            return;
        }


        var allowedTypes = new[]
        {
            "image/jpeg",
            "image/png",
            "image/webp"
        };


        if (!allowedTypes.Contains(
                file.ContentType.ToLowerInvariant()))
        {
            ErrorMessage =
                "Only JPG, JPEG, PNG and WEBP images are allowed.";

            RemoveImage();

            return;
        }


        SelectedImage = file;


        try
        {
            await using var stream =
                file.OpenReadStream(MaxFileSize);

            using var memoryStream =
                new MemoryStream();

            await stream.CopyToAsync(memoryStream);


            ImagePreview =
                $"data:{file.ContentType};base64," +
                Convert.ToBase64String(
                    memoryStream.ToArray());
        }
        catch
        {
            ErrorMessage =
                "Unable to preview the selected image.";

            RemoveImage();
        }
    }


    private void RemoveImage()
    {
        SelectedImage = null;
        ImagePreview = null;
    }


    private string GetFileSize()
    {
        if (SelectedImage == null)
            return string.Empty;


        if (SelectedImage.Size >= 1024 * 1024)
        {
            return
                $"{SelectedImage.Size / 1024d / 1024d:0.0} MB";
        }


        return
            $"{SelectedImage.Size / 1024d:0} KB";
    }


    private async Task HandleValidSubmit()
    {
        ErrorMessage = null;


        if (SelectedImage == null)
        {
            ErrorMessage =
                "Please upload an image for the program.";

            return;
        }


        try
        {
            IsSaving = true;


            // var result =
            //     await ProgramApiService.CreateProgram(
            //         Program,
            //         SelectedImage);


            // if (result != null && result.success)
            // {
            //     Navigation.NavigateTo(
            //         "/admin/programs");
            // }
            // else
            // {
            //     ErrorMessage =
            //         result?.message
            //         ?? "Unable to create program.";
            // }
        }
        catch (Exception)
        {
            ErrorMessage =
                "An error occurred while creating the program.";
        }
        finally
        {
            IsSaving = false;
        }
    }


    private void GoBack()
    {
        Navigation.NavigateTo(
            "/admin/programs");
    }


    public class CreateProgramModel
    {
        [Required(
            ErrorMessage = "Program name is required.")]
        [StringLength(
            200,
            ErrorMessage =
                "Program name cannot exceed 200 characters.")]
        public string ProgramName { get; set; }
            = string.Empty;


        [Required(
            ErrorMessage =
                "Program description is required.")]
        [StringLength(
            2000,
            MinimumLength = 20,
            ErrorMessage =
                "Description must be between 20 and 2000 characters.")]
        public string Description { get; set; }
            = string.Empty;


        [Required(
            ErrorMessage =
                "Program date is required.")]
        public DateTime? ProgramDate { get; set; }
    }
}
