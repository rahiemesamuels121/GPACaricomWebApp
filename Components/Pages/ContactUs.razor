@page "/contact-us"
@rendermode InteractiveServer

<PageTitle>Contact Us</PageTitle>

<div class="contact-hero">
    <h1>Get In Touch</h1>
    <p>
        We'd love to hear from you. Reach out for information about our
        programs, partnerships, and opportunities.
    </p>
</div>

<div class="container py-5">

    <div class="row g-4">

        <!-- Contact Information -->
        <div class="col-lg-4">

            <div class="contact-card">
                <i class="bi bi-telephone-fill contact-icon"></i>
                <h4>Call Us</h4>
                <p>+1 (876) 481-8916</p>
            </div>

            <div class="contact-card">
                <i class="bi bi-envelope-fill contact-icon"></i>
                <h4>Email</h4>
                <a href="mailto:gpacaricom@gmail.com">
                    gpacaricom@gmail.com
                </a>
            </div>

            <div class="contact-card">
                <i class="bi bi-instagram contact-icon"></i>
                <h4>Instagram</h4>
                <a href="https://www.instagram.com/gpa_caribbean/"
                   target="_blank">
                    @@gpa_caribbean
                </a>
            </div>

        </div>

        <!-- Contact Form -->
        <div class="col-lg-8">

            <div class="contact-form-card">

                <h3>Send Us a Message</h3>

                <div class="mb-3">
                    <input class="form-control"
                           placeholder="Full Name" />
                </div>

                <div class="mb-3">
                    <input class="form-control"
                           placeholder="Email Address" />
                </div>

                <div class="mb-3">
                    <input class="form-control"
                           placeholder="Subject" />
                </div>

                <div class="mb-3">
                    <textarea class="form-control"
                              rows="6"
                              placeholder="Your Message"></textarea>
                </div>

                <button class="btn btn-warning px-4">
                    Send Message
                </button>

            </div>

        </div>

    </div>

</div>
