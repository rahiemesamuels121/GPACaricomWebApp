@page "/"
@rendermode InteractiveServer

@using GPACARICOM.Models
@using GPACARICOM.Components
@using GPACARICOM.Services.API

@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject ArticleApiService articleapiservice
@inject TestimonialApiService testimonialApiService

@implements IAsyncDisposable


<PageTitle>Home</PageTitle>


<div @ref="homepageRoot"
     class="gpa-home">


    <!-- =========================================================
         HERO
         ========================================================= -->
    <section class="home-hero">

        <div class="hero-carousel">
            <Carosel />
        </div>

        <div class="hero-overlay"></div>


        <div class="container hero-container">

            <div class="hero-content"
                 data-scroll-reveal
                 data-reveal="hero">

                <span class="hero-eyebrow">
                    GPA Caribbean
                </span>


                <h1>
                    Empowering Caribbean
                    Youth Through Opportunity
                </h1>


                <p>
                    GPA Caribbean provides programs,
                    mentorship and opportunities that help
                    young people achieve academic and
                    professional success.
                </p>


                <div class="hero-actions">

                    <a href="/work-and-travel/information"
                       class="btn-primary-modern">

                        Apply for Work &amp; Travel 2027

                    </a>


                    <a href="/our-programs"
                       class="btn-secondary-modern">

                        Explore Programs

                    </a>

                </div>

            </div>

        </div>

    </section>



    <!-- =========================================================
         PROGRAMS
         ========================================================= -->
    <section class="home-section programs-section">

        <div class="container">

            <div class="section-shell">


                <div class="section-eyebrow"
                     data-scroll-reveal
                     data-reveal="fade">

                    Our Programs

                </div>


                <div class="section-intro"
                     data-scroll-reveal
                     data-reveal="title">

                    <div>

                        <h2>
                            Opportunities Designed
                            To Move You Forward
                        </h2>

                        <span class="title-line"></span>

                    </div>


                    <div>

                        <p>
                            Explore programs designed to help
                            Caribbean youth build professional
                            experience, develop leadership skills,
                            and create meaningful opportunities.
                        </p>

                    </div>

                </div>



                <div class="row g-4 program-grid">


                    <!-- WORK & TRAVEL -->
                    <div class="col-lg-4 col-md-6"
                         data-scroll-reveal
                         data-reveal="slide-left">


                        <a href="/work-and-travel-registration"
                           class="program-card">


                            <span class="program-number">
                                01
                            </span>


                            <div class="program-icon">

                                <i class="bi bi-airplane"></i>

                            </div>


                            <h3>
                                Work &amp; Travel
                            </h3>


                            <p>
                                Gain valuable international
                                employment experience while building
                                professional, cultural and leadership
                                skills.
                            </p>


                            <span class="program-link">

                                Learn More

                                <i class="bi bi-arrow-right"></i>

                            </span>

                        </a>

                    </div>



                    <!-- EDUCATION -->
                    <div class="col-lg-4 col-md-6"
                         data-scroll-reveal
                         data-reveal="zoom"
                         data-reveal-delay="120">


                        <a href="/our-programs"
                           class="program-card program-card-featured">


                            <span class="program-number">
                                02
                            </span>


                            <div class="program-icon">

                                <i class="bi bi-mortarboard"></i>

                            </div>


                            <h3>
                                Education Programs
                            </h3>


                            <p>
                                Access educational opportunities
                                designed to support academic,
                                professional and personal development.
                            </p>


                            <span class="program-link">

                                Explore Programs

                                <i class="bi bi-arrow-right"></i>

                            </span>

                        </a>

                    </div>



                    <!-- LEADERSHIP -->
                    <div class="col-lg-4 col-md-6"
                         data-scroll-reveal
                         data-reveal="slide-right"
                         data-reveal-delay="240">


                        <a href="/who-we-are"
                           class="program-card">


                            <span class="program-number">
                                03
                            </span>


                            <div class="program-icon">

                                <i class="bi bi-people"></i>

                            </div>


                            <h3>
                                Youth Leadership
                            </h3>


                            <p>
                                Build confidence, leadership
                                capability and meaningful professional
                                connections throughout the Caribbean.
                            </p>


                            <span class="program-link">

                                Learn More

                                <i class="bi bi-arrow-right"></i>

                            </span>

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </section>



    <!-- =========================================================
         ABOUT
         ========================================================= -->
