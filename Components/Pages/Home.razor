                    <!-- RIGHT CONTENT -->
                    <div class="col-lg-6"
                         data-scroll-reveal
                         data-reveal="slide-right">


                        <div class="about-content">


                            <div class="section-eyebrow">
                                About GPA Caribbean
                            </div>


                            <h2>
                                Creating Pathways
                                For Caribbean Youth
                            </h2>


                            <span class="title-line"></span>


                            <p class="about-description">
                                GPA Caribbean connects young people
                                with education, leadership,
                                professional development and
                                international opportunities.
                            </p>



                            <div class="about-feature-list">


                                <div class="about-feature">

                                    <div class="feature-icon">

                                        <i class="bi bi-check2"></i>

                                    </div>

                                    <div>

                                        <strong>
                                            Education
                                        </strong>

                                        <span>
                                            Building knowledge and professional skills.
                                        </span>

                                    </div>

                                </div>



                                <div class="about-feature">

                                    <div class="feature-icon">

                                        <i class="bi bi-check2"></i>

                                    </div>

                                    <div>

                                        <strong>
                                            Leadership
                                        </strong>

                                        <span>
                                            Developing confidence and capability.
                                        </span>

                                    </div>

                                </div>



                                <div class="about-feature">

                                    <div class="feature-icon">

                                        <i class="bi bi-check2"></i>

                                    </div>

                                    <div>

                                        <strong>
                                            International Experience
                                        </strong>

                                        <span>
                                            Connecting participants with opportunities abroad.
                                        </span>

                                    </div>

                                </div>



                                <div class="about-feature">

                                    <div class="feature-icon">

                                        <i class="bi bi-check2"></i>

                                    </div>

                                    <div>

                                        <strong>
                                            Professional Development
                                        </strong>

                                        <span>
                                            Supporting long-term career growth.
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <a href="/who-we-are"
                               class="text-arrow-link">

                                Learn More About GPA

                                <i class="bi bi-arrow-right"></i>

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>



    <!-- =========================================================
         PROCESS
         ========================================================= -->
    <section class="home-section process-section">

        <div class="container">

            <div class="section-shell">


                <div class="section-heading-center"
                     data-scroll-reveal
                     data-reveal="title">

                    <div class="section-eyebrow">
                        How It Works
                    </div>

                    <h2>
                        Your Journey With GPA Caribbean
                    </h2>

                    <span class="title-line title-line-center"></span>

                </div>



                <div class="process-grid">


                    <div class="process-item"
                         data-scroll-reveal
                         data-reveal="slide-left">


                        <span class="process-number">
                            01
                        </span>


                        <div class="process-icon">

                            <i class="bi bi-search"></i>

                        </div>


                        <h3>
                            Discover
                        </h3>


                        <p>
                            Explore available programs and
                            opportunities.
                        </p>

                    </div>



                    <div class="process-item"
                         data-scroll-reveal
                         data-reveal="zoom"
                         data-reveal-delay="120">


                        <span class="process-number">
                            02
                        </span>


                        <div class="process-icon">

                            <i class="bi bi-file-earmark-text"></i>

                        </div>


                        <h3>
                            Apply
                        </h3>


                        <p>
                            Complete your application and
                            required information.
                        </p>

                    </div>



                    <div class="process-item"
                         data-scroll-reveal
                         data-reveal="zoom"
                         data-reveal-delay="240">


                        <span class="process-number">
                            03
                        </span>


                        <div class="process-icon">

                            <i class="bi bi-check2-circle"></i>

                        </div>


                        <h3>
                            Prepare
                        </h3>


                        <p>
                            Receive guidance and prepare for
                            your program.
                        </p>

                    </div>



                    <div class="process-item"
                         data-scroll-reveal
                         data-reveal="slide-right"
                         data-reveal-delay="360">


                        <span class="process-number">
                            04
                        </span>


                        <div class="process-icon">

                            <i class="bi bi-graph-up-arrow"></i>

                        </div>


                        <h3>
                            Grow
                        </h3>


                        <p>
                            Build experience, confidence and
                            your future.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>



    <!-- =========================================================
         FEATURED OPPORTUNITIES
         ========================================================= -->
    <section class="home-section opportunities-section">

        <div class="container">

            <div class="section-shell">


                <div class="section-intro section-intro-light"
                     data-scroll-reveal
                     data-reveal="title">

                    <div>

                        <div class="section-eyebrow section-eyebrow-yellow">
                            Featured Opportunities
                        </div>

                        <h2>
                            Programs Worth Exploring
                        </h2>

                        <span class="title-line"></span>

                    </div>


                    <div>

                        <p>
                            Discover opportunities designed to provide
                            practical experience, career development
                            and personal growth.
                        </p>

                    </div>

                </div>



                <div class="row g-4">


                    <div class="col-lg-4"
                         data-scroll-reveal
                         data-reveal="slide-left">


                        <a href="/work-and-travel-registration"
                           class="opportunity-card">


                            <div class="opportunity-number">
                                01
                            </div>


                            <div class="opportunity-bottom">


                                <span>
                                    International Experience
                                </span>


                                <h3>
                                    Summer Work
                                    &amp; Travel
                                </h3>


                                <div class="opportunity-arrow">

                                    <i class="bi bi-arrow-up-right"></i>

                                </div>

                            </div>

                        </a>

                    </div>



                    <div class="col-lg-4"
                         data-scroll-reveal
                         data-reveal="zoom"
                         data-reveal-delay="120">


                        <a href="/our-programs"
                           class="opportunity-card opportunity-yellow">


                            <div class="opportunity-number">
                                02
                            </div>


                            <div class="opportunity-bottom">


                                <span>
                                    Professional Growth
                                </span>


                                <h3>
                                    Training &amp;
                                    Development
                                </h3>


                                <div class="opportunity-arrow">

                                    <i class="bi bi-arrow-up-right"></i>

                                </div>

                            </div>

                        </a>

                    </div>



                    <div class="col-lg-4"
                         data-scroll-reveal
                         data-reveal="slide-right"
                         data-reveal-delay="240">


                        <a href="/who-we-are"
                           class="opportunity-card opportunity-blue">


                            <div class="opportunity-number">
                                03
                            </div>


                            <div class="opportunity-bottom">


                                <span>
                                    Build Confidence
                                </span>


                                <h3>
                                    Leadership
                                    Development
                                </h3>


                                <div class="opportunity-arrow">

                                    <i class="bi bi-arrow-up-right"></i>

                                </div>

                            </div>

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </section>



    <!-- =========================================================
         LEADERSHIP BANNER
         ========================================================= -->
    <section class="impact-section">

        <div class="impact-overlay"></div>


        <div class="container">

            <div class="impact-content"
                 data-scroll-reveal
                 data-reveal="title-light">


                <span>
                    Creating Opportunity
                </span>


                <h2>
                    Building Caribbean Leaders
                </h2>


                <div class="impact-grid">


                    <div class="impact-item">

                        <strong>
                            Education
                        </strong>

                        <span>
                            Building Knowledge
                        </span>

                    </div>


                    <div class="impact-item">

                        <strong>
                            Leadership
                        </strong>

                        <span>
                            Building Confidence
                        </span>

                    </div>


                    <div class="impact-item">

                        <strong>
                            Opportunity
                        </strong>

                        <span>
                            Building Futures
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </section>



    <!-- =========================================================
         NEWS
         ========================================================= -->
    <section class="home-section news-section">

        <div class="container">

            <div class="section-shell">


                <div class="section-intro"
                     data-scroll-reveal
                     data-reveal="title">

                    <div>

                        <div class="section-eyebrow">
                            Latest Updates
                        </div>

                        <h2>
                            News &amp; Stories
                        </h2>

                        <span class="title-line"></span>

                    </div>


                    <div>

                        <p>
                            Stay informed about programs,
                            opportunities and developments
                            from GPA Caribbean.
                        </p>

                    </div>

                </div>



                @if (isLoadingArticles)
                {
                    <div class="center-div">

                        <RadzenProgressBarCircular ShowValue="true"
                                                   Mode="ProgressBarMode.Indeterminate">
                        </RadzenProgressBarCircular>

                    </div>
                }
                else
                {
                    <div class="row g-4">

                        @for (int i = 0; i < articleList.Count; i++)
                        {
                            var article = articleList[i];

                            var accent =
                                cardColors[
                                    i % cardColors.Length
                                ];


                            var animations = new[]
                            {
                                "slide-left",
                                "zoom",
                                "slide-right"
                            };


                            var animation =
                                animations[
                                    i % animations.Length
                                ];


                            <div class="col-lg-4 col-md-6"
                                 data-scroll-reveal
                                 data-reveal="@animation"
                                 data-reveal-delay="@((i % 3) * 120)">


                                <article class="news-card">


                                    <div class="news-accent"
                                         style="background:var(@accent)">
                                    </div>


                                    <div class="news-card-content">


                                        <div class="news-date">

                                            <i class="bi bi-calendar3"></i>

                                            @article.CreatedDate.ToString(
                                                "MMM dd, yyyy"
                                            )

                                        </div>


                                        <h3>
                                            @article.title
                                        </h3>


                                        <p>
                                            @article.shortDescription
                                        </p>


                                        <a href="@article.hyperlink"
                                           target="_blank">

                                            Read More

                                            <i class="bi bi-arrow-right"></i>

                                        </a>

                                    </div>

                                </article>

                            </div>
                        }

                    </div>
                }

            </div>

        </div>

    </section>



    <!-- =========================================================
         TESTIMONIALS
         ========================================================= -->
    <section class="home-section testimonials-section">

        <div class="container">

            <div class="section-shell">


                <div class="section-heading-center"
                     data-scroll-reveal
                     data-reveal="title">


                    <div class="section-eyebrow">
                        Testimonials
                    </div>


                    <h2>
                        What People Are Saying
                    </h2>


                    <span class="title-line title-line-center"></span>

                </div>



                @if (isLoadingTestimonials)
                {
                    <div class="center-div">

                        <RadzenProgressBarCircular ShowValue="true"
                                                   Mode="ProgressBarMode.Indeterminate">
                        </RadzenProgressBarCircular>

                    </div>
                }
                else
                {
                    <div class="row g-4 testimonial-grid">

                        @for (
                            int i = 0;
                            i < testimonialList.Count;
                            i++
                        )
                        {
                            var testimonial =
                                testimonialList[i];


                            var animation =
                                i % 2 == 0
                                    ? "slide-left"
                                    : "slide-right";


                            <div class="col-lg-6"
                                 data-scroll-reveal
                                 data-reveal="@animation"
                                 data-reveal-delay="@((i % 4) * 130)">


                                <article class="testimonial-card">


                                    <div class="testimonial-quote">
                                        “
                                    </div>


                                    <p class="testimonial-text">
                                        @testimonial.testimonialbody
                                    </p>


                                    <div class="testimonial-footer">


                                        <RadzenGravatar Email="info@gpa.com" />


                                        <div>

                                            <h5>
                                                @testimonial.username
                                            </h5>

                                            <span>
                                                @testimonial.testimonialTitle
                                            </span>

                                        </div>

                                    </div>

                                </article>

                            </div>
                        }

                    </div>
                }

            </div>

        </div>

    </section>



    <!-- =========================================================
         FINAL CTA
         ========================================================= -->
    <section class="final-cta">

        <div class="container">

            <div class="final-cta-inner"
                 data-scroll-reveal
                 data-reveal="fade">


                <div>

                    <span>
                        Your Next Opportunity Starts Here
                    </span>

                    <h2>
                        Ready To Take The Next Step?
                    </h2>

                </div>


                <div class="final-cta-actions">


                    <a href="/our-programs"
                       class="final-cta-primary">

                        Explore Programs

                    </a>


                    <a href="/contact-us"
                       class="final-cta-secondary">

                        Contact Us

                    </a>

                </div>

            </div>

        </div>

    </section>

</div>


<style>

    /* ============================================================
           ROOT
           ============================================================ */

    .gpa-home {
        width: 100%;
        overflow: hidden;
        background: var(--surface);
        color: var(--text-primary);
    }


    /* ============================================================
           COMMON
           ============================================================ */

    .home-section {
        padding: clamp(75px, 8vw, 115px) 0;
    }


    .section-shell {
        padding-left: clamp(18px, 3vw, 48px);
        padding-right: clamp(18px, 3vw, 48px);
    }


    .section-eyebrow {
        margin-bottom: 15px;
        color: var(--primary-blue);
        font-size: .72rem;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
    }


    .section-eyebrow-yellow {
        color: var(--primary-yellow);
    }


    .section-intro {
        display: grid;
        grid-template-columns: 1.15fr .85fr;
        align-items: end;
        gap: clamp(30px, 5vw, 70px);
        margin-bottom: clamp(40px, 5vw, 62px);
    }


        .section-intro h2,
        .section-heading-center h2,
        .about-content h2 {
            margin: 0;
            color: var(--text-primary);
            font-size: clamp(2rem, 4vw, 3.2rem);
            font-weight: 800;
            line-height: 1.08;
            letter-spacing: -1.2px;
        }


        .section-intro p {
            margin: 0;
            color: var(--text-secondary);
            font-size: .94rem;
            line-height: 1.85;
        }


    .title-line {
        display: block;
        width: 58px;
        height: 4px;
        margin-top: 17px;
        background: var(--primary-yellow);
    }


    .title-line-center {
        margin-left: auto;
        margin-right: auto;
    }


    .section-heading-center {
        max-width: 760px;
        margin: 0 auto clamp(45px, 5vw, 65px);
        text-align: center;
    }


    /* ============================================================
           HERO
           ============================================================ */

    .home-hero {
        position: relative;
        min-height: 620px;
        overflow: hidden;
        background: var(--primary-blue);
    }


    .hero-carousel {
        position: absolute;
        inset: 0;
        z-index: 1;
        width: 100%;
        height: 100%;
    }


        .hero-carousel > * {
            width: 100%;
            height: 100%;
        }


    .hero-overlay {
        position: absolute;
        inset: 0;
        z-index: 2;
        background: linear-gradient( 90deg, rgba(0,0,0,.82), rgba(0,0,0,.58) 48%, rgba(0,169,206,.15) );
    }


    .hero-container {
        position: relative;
        z-index: 3;
        display: flex;
        align-items: center;
        min-height: 620px;
    }


    .hero-content {
        max-width: 720px;
        padding: 40px 0;
        color: var(--surface);
    }


    .hero-eyebrow {
        display: inline-block;
        margin-bottom: 18px;
        color: var(--primary-yellow);
        font-size: .72rem;
        font-weight: 800;
        letter-spacing: 3px;
        text-transform: uppercase;
    }


    .hero-content h1 {
        max-width: 700px;
        margin: 0;
        color: var(--surface);
        font-size: clamp(3rem, 6vw, 5rem);
        font-weight: 800;
        line-height: 1;
        letter-spacing: -2.5px;
    }


    .hero-content p {
        max-width: 570px;
        margin: 25px 0 32px;
        color: rgba(255,255,255,.82);
        font-size: 1rem;
        line-height: 1.8;
    }


    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }


    .btn-primary-modern,
    .btn-secondary-modern {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 47px;
        padding: 11px 21px;
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .5px;
        text-transform: uppercase;
        text-decoration: none;
        transition: transform .55s cubic-bezier(.16,1,.3,1), box-shadow .55s cubic-bezier(.16,1,.3,1), background-color .4s ease, color .4s ease;
    }


    .btn-primary-modern {
        background: var(--primary-yellow);
        color: var(--text-primary);
    }


    .btn-secondary-modern {
        background: var(--primary-blue);
        color: var(--surface);
    }


        .btn-primary-modern:hover,
        .btn-secondary-modern:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(0,0,0,.16);
        }


    /* ============================================================
           PROGRAMS
           ============================================================ */

    .programs-section {
        background: var(--surface);
    }


    .program-card {
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 350px;
        padding: clamp(26px, 3vw, 38px);
        overflow: hidden;
        border: 1px solid rgba(0,169,206,.10);
        background: var(--surface);
        color: var(--text-primary);
        text-decoration: none;
        transition: transform .7s cubic-bezier(.16,1,.3,1), box-shadow .7s cubic-bezier(.16,1,.3,1), border-color .5s ease;
    }


        .program-card::before {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: var(--primary-yellow);
            content: "";
            transform: scaleX(0);
            transform-origin: left center;
            transition: transform .65s cubic-bezier(.16,1,.3,1);
        }


        .program-card:hover {
            transform: translateY(-8px);
            border-color: rgba(0,169,206,.25);
            box-shadow: 0 30px 70px rgba(0,169,206,.11);
        }


            .program-card:hover::before {
                transform: scaleX(1);
            }


