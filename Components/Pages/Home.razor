@page "/"
@rendermode InteractiveServer
@using GPACARICOM.Models
@using GPACARICOM.Components
@using GPACARICOM.Services.Interfaces
@inject NavigationManager NavigationManager
@inject IArticleService ArticleService;
@inject ItestimonialService TestimonialService;


<PageTitle>Home</PageTitle>
<!-- Infinite Carousel -->

     <div style="padding : 0px">
        <Carosel></Carosel>

     </div>
    <div class="homepage-hero">
        <div class="container">

            <h1>
                Empowering Caribbean Youth Through
                Education, Leadership & Opportunity
            </h1>

            <p>
                GPA Caribbean provides programs,
                mentorship, and opportunities that help
                young people achieve academic and professional success.
            </p>

            <div class="hero-buttons">
                <a href="/ourprograms" class="btn btn-warning">
                    Explore Programs
                </a>

                <a href="/whoweare" class="btn btn-outline-light">
                    Learn About Us
                </a>
            </div>

        </div>
    </div>
<section class="section-spacing">

    <div class="section-header">
        <h2>Latest News & Updates</h2>
    </div>

    @if (isLoadingArticles)
    {
        <div class="center-div">
            <RadzenProgressBarCircular ShowValue="true"
                                       Mode="ProgressBarMode.Indeterminate">
            </RadzenProgressBarCircular>
        </div>
    }
    else
    {
        <div class="row g-4">

            @for (int i = 0; i < articleList.Count; i++)
            {
                var article = articleList[i];
                var accent = cardColors[i % cardColors.Length];

                <div class="col-lg-4">

                    <div class="news-card">

                        <div class="news-accent"
                             style="background:var(@accent)">
                        </div>

                        <div class="p-4">

                            <small>
                                @article.CreatedDate.ToString("MMM dd, yyyy")
                            </small>

                            <h4>
                                @article.title
                            </h4>

                            <p>
                                @article.shortDescription
                            </p>

                            <a href="@article.hyperlink"
                               target="_blank">
                                Read More →
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</section>
<section class="testimonial-section">

    <div class="section-header">
        <h2>What People Are Saying</h2>
    </div>

    <div class="row g-4">

        @foreach (var testimonial in testimonialList)
        {
            <div class="col-lg-4">

                <div class="testimonial-card">

                    <RadzenGravatar Email="info@gpa.com" />

                    <h5>
                        @testimonial.username
                    </h5>

                    <h6>
                        @testimonial.testimonialTitle
                    </h6>

                    <p>
                        "@testimonial.testimonialbody"
                    </p>

                </div>

            </div>
        }

    </div>

</section>
<section class="cta-section">

    <h2>
        Ready to Get Involved?
    </h2>

    <p>
        Join one of our programs and become part
        of a growing Caribbean network of leaders.
    </p>

    <a href="/contactus"
       class="btn btn-warning btn-lg">
        Contact Us
    </a>

</section>


@code {
    private readonly string[] cardColors =
{
    "--secondary-blue",
    "--secondary-yellow",
    "--secondary-red",
};
    private List<Article> articleList= new();
    private List<TestimonialModel> testimonialList = new();
    private bool isLoadingArticles = true;
    private bool isLoadingTestimonials = true;


    protected override async Task OnInitializedAsync()
    {
        try
        {
            var articlesTask = ArticleService.GetArticlesAsync();
            var testimonialsTask = TestimonialService.GetTestimonialsAsync();

            await Task.WhenAll(articlesTask, testimonialsTask);

            articleList = articlesTask.Result;
            testimonialList = testimonialsTask.Result;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoadingArticles = false;
            isLoadingTestimonials = false;
        }


       
    }
    private void openlink(string link)
    {
        NavigationManager.NavigateTo(link);
    }

    private string getTodaysDate()
    {
        return DateTime.Now.ToString("dddd, MMMM dd, yyyy");
    }

}
