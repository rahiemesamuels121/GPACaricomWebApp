@page "/"
@rendermode InteractiveServer
@using GPACARICOM.Models
@using GPACARICOM.Components
@inject NavigationManager NavigationManager

<PageTitle>Home</PageTitle>
<!-- Infinite Carousel -->
<div class="custom-card">

<Carosel></Carosel>
</div>
<div>
    <h1>
        Things to Know
    </h1>

   <RadzenStack Gap="1rem" Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap">

    @for (int i = 0; i < articleList.Count; i++)
    {
            <div class="custom-card" style=" width: 20rem; background-color:lightgoldenrodyellow;")>
                <h3 style="color:#05163D"> @articleList[i].title</h3>
            <hr />
            <p>@articleList[i].shortDescription</p>
            <div style="justify-content:flex-end">
                    <a href="https://jis.gov.jm/government-welcomes-uss-nimitz-to-kingston-harbour/" target="_blank"> Read More</a>
            </div>
          
        </div>
    }
   </RadzenStack>
</div>
<div>
    <h1>
        Testimonials
    </h1>

    @foreach( var testimonial in testimonials)
    {
        <div class="custom-card">
            <RadzenStack>
                <RadzenGravatar Email="info@gpa.com" />
                <h7>@testimonial.username </h7>
            </RadzenStack>
           
        <h5> @testimonial.testimonialTitle</h5>
            <p>@testimonial.testimonialbody</p>
            <p> @testimonial.createdDate</p>
    </div>    
    }
</div>


