@code {

    private ElementReference homepageRoot;

    private IJSObjectReference? revealModule;

    private IJSObjectReference? revealController;

    private bool disposed;


    protected override async Task OnAfterRenderAsync(
        bool firstRender
    )
    {
        if (disposed)
            return;


        try
        {
            if (firstRender)
            {
                revealModule =
                    await JS.InvokeAsync<IJSObjectReference>(
                        "import",
                        "./Components/Pages/Home.razor.js"
                    );


                if (disposed)
                {
                    await revealModule.DisposeAsync();

                    return;
                }


                revealController =
                    await revealModule
                        .InvokeAsync<IJSObjectReference>(
                            "initialize",
                            homepageRoot
                        );
            }


            if (revealController is not null)
            {
                await revealController
                    .InvokeVoidAsync(
                        "refresh"
                    );
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }


    public async ValueTask DisposeAsync()
    {
        disposed = true;


        try
        {
            if (revealController is not null)
            {
                await revealController
                    .InvokeVoidAsync(
                        "dispose"
                    );


                await revealController
                    .DisposeAsync();
            }


            if (revealModule is not null)
            {
                await revealModule
                    .DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }


    private readonly string[] cardColors =
    {
        "--primary-blue",
        "--primary-yellow"
    };


    private List<Article> articleList =
        new();


    private List<TestimonialModel> testimonialList =
        new();


    private bool isLoadingArticles =
        true;


    private bool isLoadingTestimonials =
        true;


    protected override async Task OnInitializedAsync()
    {
        try
        {
            var articlesTask =
                articleapiservice
                    .GetAllArticles();


            var testimonialsTask =
                testimonialApiService
                    .GetAllTestimonials();


            await Task.WhenAll(
                articlesTask,
                testimonialsTask
            );


            articleList =
                articlesTask.Result.data!;


            testimonialList =
                testimonialsTask.Result.data!;
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                ex.Message
            );
        }
        finally
        {
            isLoadingArticles =
                false;


            isLoadingTestimonials =
                false;
        }
    }


