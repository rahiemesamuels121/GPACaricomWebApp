@page "/ourprograms"
@attribute [StreamRendering]
@using GPACARICOM.Models

<PageTitle>Our Programs</PageTitle>

<div>
    <h1>Our Programs</h1>
</div>

<div class="row">
    @foreach (ProgramModel program in programlist)
    {
        <div class="col-md-4 mb-3">
            <div class="custom-card" style="background-color:var(--background); height:400px; overflow:clip">
                <img src="images/logomain.png" style="height: 100px ; width : 100px" class="catalog-image"/>
                <h3>@program.programName</h3>
                <p> @program.programDescription</p>
            </div>
        </div>
    }
</div>

