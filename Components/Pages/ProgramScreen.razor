@page "/our-programs"
@attribute [StreamRendering]
@using GPACARICOM.Models
@using GPACARICOM.Services.API
@inject ProgramApiService programApiService;
@inject NavigationManager NavigationManager;
@rendermode InteractiveServer
@* @attribute [Authorize] *@

<PageTitle>Our Programs</PageTitle>


<!-- Hero Section -->
<div class="programs-hero">
    <h1>Our Programs</h1>
    <p>
        Empowering Caribbean youth through education,
        leadership development, entrepreneurship, and community engagement.
    </p>
</div>

<div class="container py-5">

    @if (isLoadingPrograms)
    {
        <div class="center-div">
            <RadzenProgressBarCircular    style="color: var(--primary-blue)"
                                       Mode="ProgressBarMode.Indeterminate"
                                       Size="ProgressBarCircularSize.Large">
                <Template>Loading</Template>
            </RadzenProgressBarCircular>
        </div>
    }
    else
    {
        <div class="row g-4">

            @for (int i = 0; i < programlist.Count; i++)
            {
                var program = programlist[i];
                var accentColor = cardColors[i % cardColors.Length];

                <div class="col-lg-4 col-md-6">

                    <div class="program-card">

                        <div class="program-accent"
                             style="background:@accentColor;">
                        </div>

                        <div class="program-content">

                            <div class="program-icon">
                                <img src="/images/logomain.png"
                                     alt="Program"
                                     class="program-logo" />
                            </div>

                            <h3>@program.programName</h3>

                            <p>
                                @program.programDescription
                            </p>
                        
                            <button class="btn program-btn"
                                    style="background:@accentColor;"
                                    @onclick="()=>ViewProgram(program.programid)">
                                Learn More
                            </button>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>

@code{
    private readonly string[] cardColors =
{
    "#E8F4FD", // Blue
    "#FFF8E1", // Yellow
    "#E3FCEF", // Green 
    "#FDEDED", // Red
};

    private List<ProgramModel> programlist;
    private bool isLoadingPrograms = true;
    protected override async Task OnInitializedAsync()
    {
        var results = await programApiService.GetAllTestimonials();
        programlist = results.data!;
        isLoadingPrograms = false;
    }

    private void ViewProgram(int programId)
    {
        NavigationManager.NavigateTo($"/program-details/{programId}");
    }


}



