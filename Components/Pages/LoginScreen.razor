@page "/login"
@layout LogInLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components

<div class="login-page">

    <!-- Left Side -->
    <div class="login-left">

        <div class="brand-content">

            <img src="images/logomain.png"
                 class="brand-logo"
                 alt="Logo" />

            <h1>Welcome Back</h1>

            <p>
                Sign in to access your training programs,
                certifications, courses and account dashboard.
            </p>

        </div>

    </div>

    <!-- Right Side -->
    <div class="login-right">
       
        
        <div class="login-card">
            <button type="button"
                    class="login-close-btn"
                    aria-label="Close login"
                    onclick="goBackToPreviousPage()">
                <i class="bi bi-x-lg"></i>
            </button>

            <h2>Sign In</h2>

            <p class="text-muted mb-4">
                Enter your credentials below
            </p>
            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-circle me-2"></i>
                    @ErrorMessage
                </div>
            }


            <form method="post" action="/account/login">

                <div class="mb-3">
                    <label>Email Address</label>
                    <input class="form-control"
                           id ="username"
                           type="email"
                           name="Username"
                           placeholder="john@email.com"
                           required/>
                </div>
                <div class="mb-2">

                    <label>Password</label>

                    <input class="form-control"
                           type="password"
                           id="password"
                           name="Password"
                           placeholder="••••••••" 
                           required/>
                </div>
                <div class="login-options">
                    <div>
                        <input type="checkbox"
                               id="remember" />

                        <label for="remember">
                            Remember Me
                        </label>

                    </div>

                    <a href="/forgot-password">
                        Forgot Password?
                    </a>

                </div>

                <button class="btn login-btn w-100 mt-3"
                        type="submit"
                        id="loginButton">

                    <span id="loginButtonText">
                        Sign In
                    </span>

                    <span id="loginSpinner"
                          class="spinner-border spinner-border-sm ms-2 d-none"
                          role="status"
                          aria-hidden="true">
                    </span>

                </button>

            </form>

            @* <div class="divider">
                <span>or continue with</span>
            </div> *@

          @*   <div class="social-buttons">

                <button class="btn social-btn">
                    <i class="bi bi-google"></i>
                    Google
                </button>

                <button class="btn social-btn">
                    <i class="bi bi-microsoft"></i>
                    Microsoft
                </button>

            </div> *@

            <div class="signup-text">

                Don't have an account?

                <a href="/register">
                    Create Account
                </a>

            </div>

        </div>

    </div>

</div>
<script>
    function goBackToPreviousPage() {
        if (window.history.length > 1) {
            window.history.back();
        } else {
            window.location.href = "/";
        }
    }

    function showLoginLoading() {
        const button = document.getElementById("loginButton");
        const buttonText = document.getElementById("loginButtonText");
        const spinner = document.getElementById("loginSpinner");

        button.disabled = true;
        buttonText.innerText = "Signing In...";
        spinner.classList.remove("d-none");
    }
</script>
@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorMessage { get; set; }
}