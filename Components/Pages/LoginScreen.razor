@using System.Security.Claims
@using GPACARICOM.Components.Layout
@using GPACARICOM.Models
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@* @inject AuthApiService authApiService; *@
@inject NavigationManager navigationManager
@inject NotificationService notificatinservice
@rendermode InteractiveServer



@page "/login"
@layout LogInLayout

<div class="login-container">
    <div class="login-overlay">

        <div class="login-card">

            <div class="text-center mb-4">
                <img src="images/logomain.png"
                     alt="Logo"
                     class="login-logo" />

                <h2>Welcome Back</h2>
                <p>Sign in to continue</p>
            </div>



            <form method="post" action="/account/login">

    <div class="mb-3">
        <label>Email</label>
        <input
            class="form-control"
            type="text"
            name="Username" />
    </div>

    <div class="mb-3">
        <label>Password</label>
        <input
            class="form-control"
            type="password"
            name="Password" />
    </div>

    <button class="btn login-btn w-100" type="submit">
        Sign In
    </button>

</form>

