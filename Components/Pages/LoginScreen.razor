@using GPACARICOM.Components.Layout
@using GPACARICOM.Models
@using GPACARICOM.Services.Interfaces
@page "/login"
@layout LogInLayout
@inject IAuthService Authservice;

<div class="login-container">
    <div class="login-overlay">

        <div class="login-card">

            <div class="text-center mb-4">
                <img src="images/logomain.png"
                     alt="Logo"
                     class="login-logo" />

                <h2>Welcome Back</h2>
                <p>Sign in to continue</p>
            </div>

            <EditForm Model="@loginRequest" OnValidSubmit="Login" FormName="LoginForm">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label>Email</label>
                    <InputText class="form-control"
                               @bind-Value="loginRequest.Username" />
                </div>

                <div class="mb-3">
                    <label>Password</label>
                    <InputText type="password"
                               class="form-control"
                               @bind-Value="loginRequest.Password" />
                </div>

                <button class="btn login-btn w-100">
                    Sign In
                </button>
            </EditForm>

        </div>

    </div>
</div>

@code {
    private UserLoginRequest loginRequest = new();

    private async Task Login()
    {
        await Authservice.Login(
            loginRequest
        );
    }

   
}