@page "/register"
@layout LogInLayout
@rendermode InteractiveServer

<div class="signup-page">

    <!-- Left Side -->
    <div class="signup-left">

        <div class="brand-content">

            <img src="images/logomain.png"
                 class="brand-logo"
                 alt="Logo" />

            <h1>Create Your Account</h1>

            <p>
                Register to access training programs,
                certifications, courses and your personal dashboard.
            </p>

        </div>

    </div>

    <!-- Right Side -->
    <div class="signup-right">

        <div class="signup-card">

            <h2>Create Account</h2>

            <p class="text-muted mb-4">
                Fill in your information below
            </p>

            <form method="post" action="/account/register">

                <!-- Account Type -->
                <div class="mb-3">

                    <label class="form-label">Register As</label>

                    <select class="form-select" name="AccountType" @bind="AccountType">

                        <option value="">Select Account Type</option>
                        <option value="Individual">Individual</option>
                        <option value="Organization">Organization</option>

                    </select>

                </div>
                @if (AccountType == "Individual")
                {
                    <div class="mb-3">

                        <label class="form-label">
                            First Name 
                        </label>

                        <input class="form-control"
                               type="text"
                               name="Name"
                               placeholder="Enter your first name" />
                    </div>
                    <div class="mb-3">

                        <label class="form-label">
                            Last Name
                        </label>

                        <input class="form-control"
                               type="text"
                               name="Name"
                               placeholder="Enter your last name" />
                    </div>
                }

                @if (AccountType == "Organization")
                {
                    <div class="mb-3">

                        <label class="form-label">
                            Organization Name
                        </label>

                        <input class="form-control"
                               type="text"
                               name="Name"
                               placeholder="Enter your Organization's' Name" />

                    </div>
                    <div class="mb-3">

                        <label class="form-label">
                            Organization Contact 
                        </label>

                        <input class="form-control"
                               type="text"
                               name="Name"
                               placeholder="Enter your Name" />

                    </div>
                }

                <!-- Name -->
                

                <!-- Email -->
                <div class="mb-3">

                    <label class="form-label">
                        Email Address
                    </label>

                    <input class="form-control"
                           type="email"
                           name="Email"
                           placeholder="example@email.com" />

                </div>

                <!-- Contact -->
                <div class="mb-3">

                    <label class="form-label">
                        Contact Number
                    </label>

                    <input class="form-control"
                           type="tel"
                           name="Phone"
                           placeholder="+1 (876) 555-1234" />

                </div>

                <!-- Address -->
                <div class="mb-3">

                    <label class="form-label">
                        Address
                    </label>

                    <textarea class="form-control"
                              rows="3"
                              name="Address"
                              placeholder="Enter your address"></textarea>

                </div>

                <!-- Password -->
                <div class="mb-3">

                    <label class="form-label">
                        Password
                    </label>

                    <input class="form-control"
                           type="password"
                           name="Password"
                           placeholder="Create a password" />

                </div>

                <!-- Confirm Password -->
                <div class="mb-3">

                    <label class="form-label">
                        Confirm Password
                    </label>

                    <input class="form-control"
                           type="password"
                           name="ConfirmPassword"
                           placeholder="Confirm your password" />

                </div>

                <button class="btn signup-btn w-100 mt-3"
                        type="submit">

                    Create Account

                </button>

            </form>

            <div class="divider">
                <span>or</span>
            </div>

            <div class="social-buttons">

                <button class="btn social-btn">

                    <i class="bi bi-google"></i>
                    Google

                </button>

                <button class="btn social-btn">

                    <i class="bi bi-microsoft"></i>
                    Microsoft

                </button>

            </div>

            <div class="signup-text">

                Already have an account?

                <a href="/login">
                    Sign In
                </a>

            </div>

        </div>

    </div>

</div>
@code {
    private string? AccountType;
}