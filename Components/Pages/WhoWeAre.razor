@page "/whoweare"
@rendermode InteractiveServer

<PageTitle>WhoWeAre</PageTitle>
   
        
       
        <div class="about-hero">

            <h1>Who We Are</h1>

            <p>
                Building the next generation of Caribbean leaders,
                innovators, entrepreneurs, and professionals.
            </p>

        </div>
        <section class="container py-5">

            <div class="row align-items-center">

                <div class="col-lg-4 text-center">

                    <img src="/images/logomain.png"
                         class="about-logo"
                         alt="GPA Caribbean" />

                </div>

                <div class="col-lg-8">

                    <h2>About GPA Caribbean</h2>

                    <p>
                        GPA Caribbean is a regional youth development and
                        empowerment organisation dedicated to preparing
                        the next generation of Caribbean leaders,
                        innovators, entrepreneurs, and professionals.
                    </p>

                    <p>
                        Through leadership development, skills training,
                        entrepreneurship support, and international
                        opportunities, we help young people unlock
                        their potential and contribute to a stronger,
                        more connected Caribbean.
                    </p>

                </div>

            </div>

        </section>
<section class="container py-5">

    <div class="row g-4">

        <div class="col-lg-6">

            <div class="mission-card">

                <h2>
                    <i class="bi bi-bullseye"></i>
                    Our Mission
                </h2>

                <p>
                    To empower Caribbean youth and nurture
                    professional growth through transformative
                    training, international exchange and travel
                    opportunities, STEM-focused internships,
                    entrepreneurship development, and leadership programmes.
                </p>

            </div>

        </div>

        <div class="col-lg-6">

            <div class="vision-card">

                <h2>
                    <i class="bi bi-eye-fill"></i>
                    Our Vision
                </h2>

                <p>
                    To create a globally competitive,
                    innovative, and interconnected Caribbean
                    youth community that drives sustainable
                    economic growth, regional cooperation,
                    and social transformation.
                </p>

            </div>

        </div>

    </div>

</section>
            
   

<section class="leadership-section">

    <div class="container">

        <div class="section-header">

            <h2>Meet Our Principal Officer</h2>

        </div>

        <div class="row align-items-start">

            <div class="col-lg-4 text-center">

                <img src="/images/principalofficer.jpg"
                     class="leader-image"
                     alt="Harry Logan" />

                <h4 class="mt-4">
                    Mr. Harry Logan
                </h4>

                <p class="leader-title">
                    Principal Officer
                </p>

            </div>

            <div class="col-lg-8">

                <div class="leadership-card">

                    <p>
                        Harry Logan has dedicated his career to youth
                        development, regional cooperation, public service,
                        disaster preparedness, and educational exchange.
                    </p>

                    <p>
                        Throughout his professional journey he has worked
                        across multiple Caribbean territories, helping
                        create opportunities for young people through
                        training, international exchanges, internships,
                        and workforce development programmes.
                    </p>

                    <p>
                        His leadership continues to shape GPA Caribbean's
                        vision of creating pathways that connect Caribbean
                        youth to education, entrepreneurship, and regional
                        opportunities.
                    </p>

                    <a class="btn btn-warning">
                        Read Full Biography
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>
<section class="about-cta">

    <h2>
        Join the Movement
    </h2>

    <p>
        Together we are creating opportunities
        for Caribbean youth to thrive.
    </p>

    <a href="/ourprograms"
       class="btn btn-warning btn-lg">
        Explore Our Programs
    </a>

</section>

